@{
    var pageTitle = ViewData["Title"] as string;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var userName = User.Identity?.Name ?? string.Empty;
    var userInitial = userName.Length > 0 ? userName.Substring(0, 1) : "?";
}
<!DOCTYPE html>
<html lang="tr" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(string.IsNullOrWhiteSpace(pageTitle) ? "CineVerse" : $"{pageTitle} · CineVerse")</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="cv-header sticky-top">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand cv-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-film"></i>Cine<span>Verse</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Menüyü aç/kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" ? "active" : "")"
                               asp-area="" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>
                        @* İleride buraya "Türler" açılır menüsü gelecek (ViewComponent ile). *@
                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#"
                                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="cv-avatar">@userInitial</span>
                                    <span>@userName</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @if (User.IsInRole(Roles.Admin))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-area="Administrator" asp-controller="Home" asp-action="Index">
                                                <i class="bi bi-speedometer2 me-2"></i>Yönetim Paneli
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                    }
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">Giriş Yap</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-accent btn-sm px-3" asp-area="" asp-controller="Account" asp-action="Register">Kayıt Ol</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @* Ana sayfadaki büyük vitrin (carousel) gibi tam genişlikte alanlar için *@
    @await RenderSectionAsync("Hero", required: false)

    <main class="cv-main">
        <div class="container">
            @if (TempData["Success"] is string successMessage)
            {
                <div class="cv-alert cv-alert-success" role="status">
                    <i class="bi bi-check-circle-fill"></i>@successMessage
                </div>
            }
            @if (TempData["Error"] is string errorMessage)
            {
                <div class="cv-alert cv-alert-error" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i>@errorMessage
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <footer class="cv-footer">
        <div class="container d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
            <a class="cv-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-film"></i>Cine<span>Verse</span>
            </a>
            <p class="m-0">&copy; @DateTime.Now.Year CineVerse · Film severler için inceleme platformu</p>
        </div>
    </footer>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
