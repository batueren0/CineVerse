@model HomeViewModel
@{
    ViewData["Title"] = "Home";
}

@section Hero {
    @if (Model.Carousel.Any())
    {
        var slides = Model.Carousel.ToList();

        <section class="cv-hero">
            <div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel">
                @if (slides.Count > 1)
                {
                    <div class="carousel-indicators">
                        @for (var i = 0; i < slides.Count; i++)
                        {
                            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="@i"
                                    class="@(i == 0 ? "active" : "")" aria-label="Slide @(i + 1)"></button>
                        }
                    </div>
                }

                <div class="carousel-inner">
                    @for (var i = 0; i < slides.Count; i++)
                    {
                        var movie = slides[i];
                        var hasPoster = !string.IsNullOrEmpty(movie.PosterUrl);
                        var reviewCount = movie.Reviews.Count();

                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            @* Afiş varsa arka plana bulanık olarak yayılıyor, yoksa renkli bir gradyan kullanılıyor *@
                            <div class="hero-slide @(hasPoster ? "" : $"hero-fallback-{i % 3 + 1}")">
                                @if (hasPoster)
                                {
                                    <div class="hero-backdrop" style="background-image: url('@movie.PosterUrl')"></div>
                                }
                            </div>

                            <div class="hero-content">
                                <div class="container d-flex align-items-center justify-content-between gap-5">
                                    <div>
                                        <span class="hero-kicker">
                                            <i class="bi bi-fire"></i>@(reviewCount > 0 ? "Most talked about" : "Featured")
                                        </span>
                                        <h1 class="hero-title">@movie.Title</h1>
                                        <div class="hero-meta">
                                            <span><i class="bi bi-calendar3 me-1"></i>@movie.ReleaseYear</span>
                                            <span><i class="bi bi-camera-reels me-1"></i>@movie.Director</span>
                                            <span class="chip chip-accent">@movie.Genre.Name</span>
                                        </div>
                                        <p class="hero-overview">@movie.Overview</p>
                                        <a class="btn btn-accent px-4" asp-controller="Movies" asp-action="Details" asp-route-slug="@movie.Slug">
                                            <i class="bi bi-play-fill me-1"></i>View Details
                                        </a>
                                    </div>

                                    @if (hasPoster)
                                    {
                                        <img class="hero-poster d-none d-md-block" src="@movie.PosterUrl" alt="@movie.Title poster" />
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
}

<div class="row g-4 g-xl-5">
    <div class="col-lg-8">
        @if (Model.InTheaters.Any())
        {
            <section class="mb-5">
                <div class="section-title">
                    <h2>In Theaters</h2>
                    <a asp-controller="Movies" asp-action="InTheaters">See all <i class="bi bi-arrow-right"></i></a>
                </div>

                <div class="row row-cols-2 row-cols-md-3 g-3 g-md-4">
                    @foreach (var movie in Model.InTheaters)
                    {
                        <div class="col">
                            <partial name="_MovieCard" model="movie" />
                        </div>
                    }
                </div>
            </section>
        }

        <section>
            <div class="section-title">
                <h2>Latest Movies</h2>
                <a asp-controller="Movies" asp-action="Index">See all <i class="bi bi-arrow-right"></i></a>
            </div>

            @if (!Model.Latest.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-film"></i>
                    No movies have been added yet.
                </div>
            }
            else
            {
                <div class="row row-cols-2 row-cols-md-3 g-3 g-md-4">
                    @foreach (var movie in Model.Latest)
                    {
                        <div class="col">
                            <partial name="_MovieCard" model="movie" />
                        </div>
                    }
                </div>
            }
        </section>
    </div>

    <aside class="col-lg-4">
        @if (Model.Recent.Any())
        {
            <div class="cv-panel">
                <h3 class="cv-panel-title">Just Added</h3>
                <ul class="mini-list">
                    @foreach (var movie in Model.Recent)
                    {
                        <li>
                            <a class="mini-item" asp-controller="Movies" asp-action="Details" asp-route-slug="@movie.Slug">
                                <span class="mini-thumb">
                                    @if (string.IsNullOrEmpty(movie.PosterUrl))
                                    {
                                        <span class="poster-placeholder"><i class="bi bi-film"></i></span>
                                    }
                                    else
                                    {
                                        <img src="@movie.PosterUrl" alt="" loading="lazy" />
                                    }
                                </span>
                                <span>
                                    <strong>@movie.Title</strong>
                                    <small>@movie.ReleaseYear · @movie.Genre.Name</small>
                                </span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }

        @* Bu iki kutunun verisi controller'dan değil, kendi ViewComponent'lerinden geliyor *@
        @await Component.InvokeAsync("Genres")
        @await Component.InvokeAsync("Tags")
    </aside>
</div>
