@*
    Bu view'ı dört action kullanıyor: Index (bütün filmler), InTheaters (vizyondakiler),
    Genre ve Tag (bir türün / etiketin filmleri). Genre ve Tag sayfalarında başlığı
    controller ViewData["Heading"] ile gönderiyor; diğerlerinde action'a bakıp kendimiz seçiyoruz.
*@
@model IEnumerable<MovieResponse>
@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isInTheaters = action == "InTheaters";

    var heading = ViewData["Heading"] as string ?? (isInTheaters ? "In Theaters" : "Movies");
    var subheading = ViewData["Subheading"] as string ?? (isInTheaters
        ? "Movies currently playing in theaters."
        : "Every movie on CineVerse, newest first.");
    var emptyMessage = isInTheaters
        ? "Nothing is playing in theaters right now."
        : "No movies here yet.";

    ViewData["Title"] = heading;
}

<div class="page-intro">
    <h1 class="page-heading">@heading</h1>
    <p class="text-muted-cv mb-0">@subheading</p>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi @(isInTheaters ? "bi-ticket-perforated" : "bi-film")"></i>
        @emptyMessage
    </div>
}
else
{
    <div class="row row-cols-2 row-cols-sm-3 row-cols-lg-4 row-cols-xl-5 g-3 g-md-4">
        @foreach (var movie in Model)
        {
            <div class="col">
                <partial name="_MovieCard" model="movie" />
            </div>
        }
    </div>
}
